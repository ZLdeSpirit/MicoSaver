<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center"
    android:id="@+id/downloadingContainer">

    <ImageView
        android:id="@+id/downloadingImageIv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@color/ms_c_default_image"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/downloadingDescTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#02131B"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/downloadingProgressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="@drawable/ms_downloading_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/downloadingProgressTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:gravity="center"
        android:textColor="#02131B"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="32dp">

        <include
            android:id="@+id/viewBtn"
            layout="@layout/ms_notification_animation_small"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/actionBtnText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#1E1E1E"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
