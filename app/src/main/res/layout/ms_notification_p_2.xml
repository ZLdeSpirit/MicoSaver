<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:id="@+id/notificationContainer">

    <TextView
        android:layout_width="0px"
        android:layout_height="1px"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/downloadingIv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ms_ic_notice_download"/>

    <TextView
        android:layout_width="0px"
        android:layout_height="1px"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/localVideosIv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ms_ic_notice_local"/>

    <TextView
        android:layout_width="0px"
        android:layout_height="1px"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/favoriteIv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ms_ic_notice_favorite"/>

    <TextView
        android:layout_width="0px"
        android:layout_height="1px"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/settingsIv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ms_ic_notice_settings"/>

    <TextView
        android:layout_width="0px"
        android:layout_height="1px"
        android:layout_weight="1"/>

</LinearLayout>